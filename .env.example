# Local Google OAuth credentials, read by the Supabase CLI from the root .env file.
# Copy this file to .env and fill these in before starting the local stack.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Optional local test room owner. Use the email you sign in with via Google.
# Read by the local start/reset/seed commands; not needed in production.
SEED_OWNER_EMAIL=

# npm run supabase-env writes the local app values to .env.development.local.
# For hosted Supabase, put your hosted public values in .env.local or your host.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# TMDB API Read Access Token (server-only; never prefix with NEXT_PUBLIC_).
# Set in .env.local for development and in the hosting environment for deployment.
TMDB_ACCESS_TOKEN=
