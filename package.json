{
  "name": "reelette",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "supabase-start": "supabase start && node scripts/supabase-local.mjs seed --if-configured",
    "supabase-stop": "supabase stop",
    "supabase-status": "supabase status",
    "supabase-env": "node scripts/supabase-local.mjs env",
    "supabase-db-migrate": "supabase migration up",
    "supabase-db-reset": "supabase db reset && node scripts/supabase-local.mjs seed --if-configured",
    "supabase-db-seed": "node scripts/supabase-local.mjs seed",
    "supabase-db-test": "docker exec -i supabase_db_reelette psql --username postgres --dbname postgres --set ON_ERROR_STOP=1 < supabase/tests/rooms.sql && docker exec -i supabase_db_reelette psql --username postgres --dbname postgres --set ON_ERROR_STOP=1 < supabase/tests/movie-requests.sql && docker exec -i supabase_db_reelette psql --username postgres --dbname postgres --set ON_ERROR_STOP=1 < supabase/tests/room-members.sql",
    "supabase-types": "node scripts/supabase-local.mjs types",
    "supabase-db-pull": "supabase db pull --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tmdb-ts": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
